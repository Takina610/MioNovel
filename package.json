{
  "name": "mionovel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "description": "把本地的小说 txt / epub 变成一个能离线读、能换主题的书架",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "pwa-assets-generator",
    "logo": "bun run scripts/make-logo.ts",
    "samples": "bun run scripts/make-samples.ts",
    "verify": "bun run scripts/verify-parsers.ts && bun run scripts/verify-epub.ts && bun run scripts/verify-decoy.ts && bun run scripts/verify-hotkey.ts",
    "verify:txt": "bun run scripts/verify-parsers.ts",
    "verify:epub": "bun run scripts/verify-epub.ts",
    "verify:decoy": "bun run scripts/verify-decoy.ts",
    "verify:hotkey": "bun run scripts/verify-hotkey.ts"
  },
  "dependencies": {
    "chardet": "^2.2.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "dompurify": "^3.4.15",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^1.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
